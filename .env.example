# Copy to .env.local and fill in locally. Never commit real values.

# Inquiry delivery. Without it, development logs the inquiry and production
# answers 503 rather than pretending it was sent.
INQUIRY_WEBHOOK_URL=

# Ask Marcus knowledge base. The API is canonical; the bundled snapshot under
# lib/ask-marcus/kb-snapshot.json is the fallback.
KB_API_URL=https://pr-axis-kb-api-matanguihanbensons-projects.vercel.app

# Free-tier model chain, tried in this order. Models can be overridden.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
